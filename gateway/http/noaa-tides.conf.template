# NOAA CO-OPS water levels behind us-tides-surge: a copy of each station's
# measured water (renewed hourly), its predictions (one copy a day) and its
# datums, and a throttle that holds what reaches NOAA to two requests a second.
proxy_cache_path /var/cache/nginx/noaa_tides levels=1:2 keys_zone=noaa_tides:10m
                 max_size=500m inactive=30d use_temp_path=off;
map $host $noaa_tides_bucket {
    default noaa_tides;
}
limit_req_zone $noaa_tides_bucket zone=noaa_tides_upstream:1m rate=2r/s;

# The throttle, as the IOC's in Pacha: only the noaa-tides locations call it,
# from inside this container. Past two a second requests wait in line (up to
# 1000, more than a cold start of every station) rather than reach NOAA at
# once: its data API turns a host away (403) after a burst of a few hundred.
server {
    listen 127.0.0.1:8091;
    resolver 127.0.0.11 valid=300s ipv6=off;
    proxy_ssl_server_name on;

    location / {
        limit_req zone=noaa_tides_upstream burst=1000;
        set $noaa_coops api.tidesandcurrents.noaa.gov;
        proxy_pass https://$noaa_coops$request_uri;
        proxy_set_header Host $noaa_coops;
        proxy_set_header User-Agent "Pacha (+https://github.com/ubica-ecuador/pacha-dashboards)";
        proxy_set_header Accept-Encoding gzip;
        gunzip on;
        proxy_read_timeout 60s;
    }
}
