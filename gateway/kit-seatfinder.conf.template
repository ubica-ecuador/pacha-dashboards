    # KIT Library's Seatfinder (seatfinder.bibliothek.kit.edu), behind
    # karlsruhe-library-seats: the seats taken and free in 16 reading rooms and
    # libraries of Karlsruhe (KIT, the Baden State Library, HKA, DHBW), every 5
    # minutes, estimated from the devices on each room's Wi-Fi, or counted by
    # the staff where it cannot be estimated. No key. One request a day of
    # readings for every room at once (about 400 KB); times are Berlin's.
    #
    # A whole day by its Berlin date, kept a day: the dashboard asks for days
    # that are over, which never change, and a day asked for before it is over
    # is right again a day later. Read with read_text, many days at once.
    location ~ "^/kit-seatfinder/day/(20[0-9][0-9]-[01][0-9]-[0-3][0-9])$" {
        set $kitseats seatfinder.bibliothek.kit.edu;
        proxy_pass https://$kitseats/karlsruhe/getdata.php?values=seatestimate,manualcount&location=LSG,LSM,LST,LSN,LSW,LBS,BIB-N,FBA,FBD,FBH,FBI,FBM,FBP,LAF,BLB,WIS&after=$1%2000:00:00&before=$1%2023:59:59&limit=100000;
        proxy_set_header Host $kitseats;
        proxy_set_header Accept-Encoding "";
        proxy_set_header User-Agent "Pacha (+https://github.com/ubica-ecuador/pacha-dashboards)";
        proxy_cache kitseats;
        proxy_cache_key $uri;
        proxy_cache_valid 200 1d;
        proxy_cache_use_stale error timeout updating http_429 http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_read_timeout 60s;
        proxy_ignore_client_abort on;
        add_header X-Cache-Status $upstream_cache_status always;
    }
    # Today so far, by its Berlin date: kept 2 minutes and renewed in the
    # background, a visitor getting the previous copy meanwhile. Read with
    # http_get (one GET), never read_text: a renewal between DuckDB's HEAD and
    # its GET would cut the file.
    location ~ "^/kit-seatfinder/today/(20[0-9][0-9]-[01][0-9]-[0-3][0-9])$" {
        set $kitseats seatfinder.bibliothek.kit.edu;
        proxy_pass https://$kitseats/karlsruhe/getdata.php?values=seatestimate,manualcount&location=LSG,LSM,LST,LSN,LSW,LBS,BIB-N,FBA,FBD,FBH,FBI,FBM,FBP,LAF,BLB,WIS&after=$1%2000:00:00&before=$1%2023:59:59&limit=100000;
        proxy_set_header Host $kitseats;
        proxy_set_header Accept-Encoding "";
        proxy_set_header User-Agent "Pacha (+https://github.com/ubica-ecuador/pacha-dashboards)";
        proxy_cache kitseats;
        proxy_cache_key $uri;
        proxy_cache_valid 200 2m;
        proxy_cache_use_stale error timeout updating http_429 http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_read_timeout 60s;
        add_header X-Cache-Status $upstream_cache_status always;
    }
