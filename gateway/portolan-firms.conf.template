    # Portolan's FIRMS catalog (NASA fire detections since 2000-11) on Source
    # Cooperative, read by the server DuckDB a range at a time: the A5 aggregates
    # (alltime-r5, r8, r10, one count column a month) and one GeoParquet of points
    # a year. nginx asks Source Cooperative for whole 4 MB slices, each once, and
    # answers any range from them, so moving a dashboard's window re-reads this
    # disk, not the internet. Only these files: no open proxy.
    #
    # Portolan replaces alltime-* and the current year's file in place. A slice is
    # therefore keyed by the file's ETag (a HEAD, cached five minutes) and asked
    # for with If-Match: a new version gets new keys and never mixes with slices of
    # the old one; in the five minutes after a replacement, a slice not yet cached
    # fails with 412 rather than mixing (DuckDB reports an error, the next query
    # after the ETag expires reads the new file). Past years never change.
    location ~ "^/portolan/firms/detections/(?:alltime-r(?:5|8|10)\.parquet|year=20[0-9][0-9]/detections\.parquet)$" {
        set $source_coop data.source.coop;
        auth_request /_portolan_firms_etag;
        auth_request_set $portolan_firms_etag $upstream_http_etag;
        slice 4m;
        proxy_pass https://$source_coop/portolan-mirrors/firms-catalog/$portolan_firms_file;
        proxy_set_header Host $source_coop;
        proxy_set_header Range $slice_range;
        proxy_set_header If-Match $portolan_firms_etag;
        proxy_set_header Accept-Encoding "";
        proxy_set_header User-Agent "Pacha (+https://github.com/ubica-ecuador/pacha-dashboards)";
        proxy_http_version 1.1;
        proxy_cache portolan;
        proxy_cache_key $uri$portolan_firms_etag$slice_range;
        proxy_cache_valid 200 206 30d;
        proxy_read_timeout 120s;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header Accept-Ranges $portolan_firms_accept_ranges always;
    }

    # The ETag of the file named above: a HEAD, never a download.
    location = /_portolan_firms_etag {
        internal;
        set $source_coop data.source.coop;
        proxy_method HEAD;
        proxy_pass https://$source_coop/portolan-mirrors/firms-catalog/$portolan_firms_file;
        proxy_set_header Host $source_coop;
        proxy_set_header Range "";
        proxy_set_header If-Match "";
        proxy_set_header Accept-Encoding "";
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_http_version 1.1;
        proxy_cache portolan_etag;
        proxy_cache_convert_head off;
        proxy_cache_methods GET HEAD;
        proxy_cache_key $portolan_firms_file;
        proxy_cache_valid 200 5m;
    }
