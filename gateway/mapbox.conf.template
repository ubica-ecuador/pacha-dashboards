    # Mapbox Isochrone API (FEED_MAPBOX_TOKEN in .env, a token with no secret
    # scope and no URL restriction: these requests come from the server):
    # /mapbox/isochrone/<profile>/<lon>,<lat>?contours_minutes=...&depart_at=...
    # with the profile driving-traffic, driving, walking or cycling. The query
    # string goes on as given, the token is added here and never leaves the
    # gateway. Kept 30 days: a departure's typical traffic does not change, and
    # the copy is all a visitor ever waits on after the first.
    location ~ "^/mapbox/isochrone/(driving-traffic|driving|walking|cycling)/(-?[0-9.]+,-?[0-9.]+)$" {
        proxy_pass http://127.0.0.1:8092/isochrone/v1/mapbox/$1/$2?$args&access_token=${FEED_MAPBOX_TOKEN};
        proxy_cache mapbox;
        proxy_cache_key mapbox-isochrone-$1-$2-$args;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_429 http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 120s;
        proxy_ignore_client_abort on;
        proxy_read_timeout 120s;
        # The token rides in the upstream URL only: never echo it back.
        proxy_hide_header Set-Cookie;
        add_header X-Cache-Status $upstream_cache_status always;
    }
