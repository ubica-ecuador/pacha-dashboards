    # Mapbox Isochrone API (FEED_MAPBOX_TOKEN in .env, a token with no secret
    # scope and no URL restriction: these requests come from the server), all in
    # the path, since DuckDB reads a ? in a file name as a wildcard:
    #   /mapbox/isochrone/<profile>/<lon>,<lat>/<minutes>.json
    #   /mapbox/isochrone/<profile>/<lon>,<lat>/<minutes>/<YYYY-MM-DDThh:mm>.json
    # profile driving-traffic, driving, walking or cycling; minutes up to four,
    # comma-separated (15,30,45); the departure in the place's local time. Polygons,
    # the largest per contour, generalized to 40 m. The token is added here and
    # never leaves the gateway. Kept 30 days: a departure's typical traffic does
    # not change, and the copy is all a visitor waits on after the first.
    location ~ "^/mapbox/isochrone/(driving-traffic|driving|walking|cycling)/(-?[0-9.]+,-?[0-9.]+)/([0-9]{1,2}(?:,[0-9]{1,2}){0,3})/(20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2})\.json$" {
        proxy_pass http://127.0.0.1:8092/isochrone/v1/mapbox/$1/$2?contours_minutes=$3&depart_at=$4&polygons=true&denoise=1&generalize=40&access_token=${FEED_MAPBOX_TOKEN};
        proxy_cache mapbox;
        proxy_cache_key mapbox-isochrone-$1-$2-$3-$4;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_429 http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 120s;
        proxy_ignore_client_abort on;
        proxy_read_timeout 120s;
        add_header X-Cache-Status $upstream_cache_status always;
    }
    location ~ "^/mapbox/isochrone/(driving-traffic|driving|walking|cycling)/(-?[0-9.]+,-?[0-9.]+)/([0-9]{1,2}(?:,[0-9]{1,2}){0,3})\.json$" {
        proxy_pass http://127.0.0.1:8092/isochrone/v1/mapbox/$1/$2?contours_minutes=$3&polygons=true&denoise=1&generalize=40&access_token=${FEED_MAPBOX_TOKEN};
        proxy_cache mapbox;
        proxy_cache_key mapbox-isochrone-$1-$2-$3;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_429 http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 120s;
        proxy_ignore_client_abort on;
        proxy_read_timeout 120s;
        add_header X-Cache-Status $upstream_cache_status always;
    }
