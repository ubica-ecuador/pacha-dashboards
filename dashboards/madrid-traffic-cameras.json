                "styles": ".cam { display: flex; flex-direction: column; height: 100%; gap: 6px; }\n.cam-view { flex: 1; min-height: 0; background: #000; border-radius: 2px; overflow: hidden; display: flex; align-items: center; justify-content: center; color: #9AA5B1; }\n.cam-caption { font-size: 12px; line-height: 1.4; color: #9AA5B1; }\n.cam-caption strong { color: inherit; }",
                "wrap": false
