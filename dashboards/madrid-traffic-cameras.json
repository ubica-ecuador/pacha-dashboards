      "panel-picture": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- The camera picked and the address of its picture, which the browser reads straight from the\n-- city (informo.madrid.es) and reloads every minute: nothing is stored here.\nSELECT camera, camera_id, picture_url,\n       CASE setting WHEN 'tunnel' THEN ' · in a tunnel: no view on the map' ELSE '' END AS note\nFROM read_parquet('http://feeds/datasets/madrid-traffic-cameras/cameras.parquet')\nWHERE camera = $camera"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The picture the camera picked last took, straight from the City Council's traffic site, reloaded every minute. The city replaces it every few minutes and blurs faces and number plates.",
          "id": 4,
          "links": [],
          "title": "${camera} now",
          "vizConfig": {
            "group": "marcusolsson-dynamictext-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "afterRender": "// Shows the picture the camera picked last took, read straight from the city and reloaded every\n// minute, and says when the city published it (the file's Last-Modified; the camera's own clock is on the picture).\nconst row = context.data || {};\ncontext.element.style.height = '100%';\nconst box = context.element.querySelector('.cam-view');\nconst age = context.element.querySelector('.cam-age');\nconst self = this;\nconst cleanup = () =\u003e setTimeout(() =\u003e {\n  if (self.box \u0026\u0026 !self.box.isConnected \u0026\u0026 self.timer) {\n    clearInterval(self.timer);\n    self.timer = null;\n    self.key = null;\n  }\n}, 0);\nif (!box || !row.picture_url) {\n  return cleanup;\n}\nif (self.key === row.picture_url \u0026\u0026 self.box === box \u0026\u0026 box.isConnected) {\n  return cleanup;\n}\nclearInterval(self.timer);\nself.key = row.picture_url;\nself.box = box;\nconst img = document.createElement('img');\nimg.alt = row.camera || '';\nimg.style.cssText = 'width:100%;height:100%;object-fit:contain;background:#000;display:block';\nimg.addEventListener('error', () =\u003e {\n  if (age) {\n    age.textContent = 'no picture from the city right now';\n  }\n});\nbox.replaceChildren(img);\nconst when = (date) =\u003e {\n  const minutes = Math.round((Date.now() - date.getTime()) / 60000);\n  const clock = date.toLocaleTimeString('en-GB', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' });\n  return 'published at ' + clock + ' Madrid time' + (minutes \u003e 1 ? ', ' + minutes + ' min ago' : ', just now');\n};\nconst load = () =\u003e {\n  const url = row.picture_url + '?t=' + Date.now();\n  img.src = url;\n  fetch(url, { method: 'HEAD', credentials: 'omit' })\n    .then((r) =\u003e r.headers.get('last-modified'))\n    .then((lm) =\u003e {\n      if (age \u0026\u0026 lm) {\n        age.textContent = when(new Date(lm));\n      }\n    })\n    .catch(() =\u003e {});\n};\nload();\nself.timer = setInterval(load, 60000);\nreturn cleanup;",
                "content": "\u003cdiv class=\"cam\"\u003e\u003cdiv class=\"cam-view\"\u003e\u003c/div\u003e\u003cdiv class=\"cam-caption\"\u003e\u003cstrong\u003e{{camera}}\u003c/strong\u003e · camera {{camera_id}}{{note}} · \u003cspan class=\"cam-age\"\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e",
                "contentPartials": [],
                "defaultContent": "Click a camera on the map, or pick one in Camera above.",
