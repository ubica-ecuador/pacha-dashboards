    "cursorSync": "Off",
    "description": "What each of Madrid's 357 traffic cameras can see of the street, worked out against OpenStreetMap's buildings and the terrain: the 74 round Puerta del Sol together, the streets none of them sees, and any camera close up beside the picture it took minutes ago.",
    "editable": true,
    "elements": {
      "card-cameras": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- How many cameras the city lists, how many of them watch the centre, and when the list was read.\nSELECT count(*) AS \"Cameras in Madrid\",\n       count(*) FILTER (WHERE 2 * 6371000 * asin(sqrt(pow(sin(radians(latitude - 40.41665) / 2), 2) + cos(radians(latitude)) * cos(radians(40.41665)) * pow(sin(radians(longitude - (-3.70379)) / 2), 2))) \u003c= 2500 AND setting \u003c\u003e 'tunnel') AS \"Watching the centre\",\n       max(listed_at) AS \"Camera list read\"\nFROM read_parquet('http://feeds/datasets/madrid-traffic-cameras/cameras.parquet')"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Every traffic camera the City Council lists, with its picture.",
          "id": 5,
          "links": [],
          "title": "Cameras in Madrid",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "fixedColor": "text",
                    "mode": "fixed"
                  },
                  "decimals": 0,
                  "unit": "none"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "/^Cameras in Madrid$/",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
                "wideLayout": true
              }
            },
            "version": "13.3.0"
          }
        }
      },
