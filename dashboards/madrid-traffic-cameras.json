      "panel-centre": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Every camera within 2.5 km of Puerta del Sol's Kilometre Zero, but the ones in a tunnel\n-- (Bailén's four), which see no street. Each one's view is worked out in the browser by the map's\n-- Viewshed layer, against OpenStreetMap's buildings and the terrain.\nSELECT camera, camera_id, latitude, longitude, round(metres) AS metres_from_sol\nFROM (SELECT *, 2 * 6371000 * asin(sqrt(pow(sin(radians(latitude - 40.41665) / 2), 2) + cos(radians(latitude)) * cos(radians(40.41665)) * pow(sin(radians(longitude - (-3.70379)) / 2), 2))) AS metres FROM read_parquet('http://feeds/datasets/madrid-traffic-cameras/cameras.parquet'))\nWHERE metres \u003c= 2500 AND setting \u003c\u003e 'tunnel'\nORDER BY camera"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Every traffic camera within 2.5 km of Puerta del Sol (but the tunnels'), each with the street it has in sight within 250 m: worked out in the browser from 10 m up, against OpenStreetMap's buildings and the terrain, all round, as the city does not say which way a camera looks. Blank streets are the ones no camera sees. Hover a view to read how high a point there must stand to be seen; click a camera to see it close up below with the picture it took.",
          "id": 2,
