            },
            "version": "13.3.0"
          }
        }
      },
      "ranking": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The 30 countries Mercator enlarges most (Antarctica left out: Mercator cannot draw the pole). Click countries to pick them, on every map and in the figures; click again to let go.",
          "id": 2,
          "links": [],
          "title": "The countries Mercator inflates most",
          "vizConfig": {
            "group": "ubica-chaski-mosaic-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "preaggregate": true,
                "reads": "",
                "spec": "params:\n  pick: { select: crossfilter }\nplot:\n  # the labels first: toggleY binds to the mark just before it, the bars\n  - mark: text\n    data: { from: countries, filterBy: $pick }\n    x: inflation\n    y: name\n    text: { sql: \"printf('%.1f×', inflation)\" }\n    textAnchor: start\n    dx: 4\n    fill: '#CCCCDC'\n  - mark: barX\n    data: { from: countries, filterBy: $pick }\n    x: inflation\n    y: name\n    fill: inflation\n    inset: 0.5\n  - select: toggleY\n    as: $pick\ncolorScale: log\ncolorDomain: [1, 20]\ncolorRange: ['#3B6E8F', '#6A9BB5', '#E8D9A8', '#F4A259', '#E4572E', '#B5121B']\ncolorInterpolate: rgb\ncolorClamp: true\nyDomain: ['Greenland', 'Norway', 'Iceland', 'Finland', 'Canada', 'Russia', 'Sweden', 'Latvia', 'Lithuania', 'United Kingdom', 'Belarus', 'Ireland', 'Poland', 'Germany', 'Czechia', 'Ukraine', 'United States of America', 'Kazakhstan', 'Austria', 'Hungary', 'Mongolia', 'Romania', 'Croatia', 'France', 'Serbia', 'Bosnia and Herz.', 'Italy', 'Bulgaria', 'Georgia', 'New Zealand']\nxLabel: Times larger on a Mercator map →\nyLabel: null\nmarginLeft: 150\nmarginRight: 50\n",
                "variables": "- param: pick\n  column: name\n  variable: country\n"
              }
            },
            "version": "2.3.2"
          }
        }
      },
