              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "description": "Every flat map distorts the globe. The world in the projection you choose, with Tissot's circles, and every country's real area against the area it takes on a Mercator web map (Greenland: 16 times too large), all computed in the browser; pick countries by clicking or by latitude.",
    "editable": true,
    "elements": {
      "about": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 9,
          "links": [],
          "title": "",
          "transparent": true,
          "vizConfig": {
            "group": "text",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "content": "### About the data\n\n- **Countries**: [Natural Earth](https://www.naturalearthdata.com/) admin 0 countries at 1:50 million, public domain,\n  read in your browser from its GitHub repository.\n- **Real area**: on the WGS 84 ellipsoid (`ST_Area_Spheroid`). **Mercator area**: the country projected to Web\n  Mercator (EPSG:3857), cut at 85° north and south like every web map, in projected square metres, which are true\n  only at the equator.\n- Everything is computed in your browser by DuckDB-WASM (Chaski) with its `spatial` extension; Mosaic (Observable\n  Plot) draws the projections and kepler.gl the web map.\n",
                "mode": "markdown"
              }
            },
            "version": "13.3.0"
          }
        }
      },
      "latitude": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Each dot is a country at the latitude of its centre, as big as its real area; the dashed curve is Mercator's enlargement there, 1 / cos² of the latitude. Drag across latitudes to pick countries.",
          "id": 3,
          "links": [],
          "title": "Latitude decides it",
          "vizConfig": {
            "group": "ubica-chaski-mosaic-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "preaggregate": true,
                "reads": "",
                "spec": "params:\n  pick: { select: crossfilter }\nplot:\n  - mark: line\n    data: { from: curve }\n    x: lat\n    y: inflation\n    stroke: '#CCCCDC'\n    strokeOpacity: 0.5\n    strokeDasharray: '4,3'\n  - mark: dot\n    data: { from: countries, filterBy: $pick }\n    x: lat\n    y: inflation\n    r: km2\n    fill: inflation\n    fillOpacity: 0.85\n    stroke: '#11141a'\n    strokeWidth: 0.5\n    clip: true\n  - select: intervalX\n    as: $pick\nyScale: log\nyDomain: [0.9, 40]\nxDomain: [-60, 85]\nrRange: [2, 18]\ncolorScale: log\ncolorDomain: [1, 20]\ncolorRange: ['#3B6E8F', '#6A9BB5', '#E8D9A8', '#F4A259', '#E4572E', '#B5121B']\ncolorInterpolate: rgb\ncolorClamp: true\nxLabel: Latitude of the country's centre →\nyLabel: ↑ Times larger on Mercator\nyTickFormat: '~s'\nmarginLeft: 50\n",
                "variables": "- param: pick\n  column: lat\n  from: lat_lo\n  to: lat_hi\n"
              }
            },
            "version": "2.3.2"
          }
        }
      },
      "merc": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdbwasm"
                      },
                      "group": "ubica-chaski-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "rawSql": "SELECT sum(merc_km2) / 1e6 AS \"Million km²\" FROM $countries WHERE name \u003c\u003e 'Antarctica' AND $__crossfilter($pickFilters)"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The area the same countries take on a Mercator map, as if it were drawn at true scale at the equator.",
          "id": 6,
          "links": [],
          "title": "Area on a Mercator map",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "fixedColor": "#E4572E",
                    "mode": "fixed"
                  },
                  "decimals": 2,
                  "noValue": "–",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "red",
                        "value": 80
                      }
                    ]
                  },
                  "unit": "suffix: M km²"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
                "wideLayout": true
