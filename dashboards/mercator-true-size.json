                "preaggregate": true,
                "reads": "",
                "spec": "params:\n  pick: { select: crossfilter }\n  proj: equal-earth\n  centre: 0\n  rotate: [$centre, 0]\nvconcat:\n  - hconcat:\n      - input: menu\n        label: Projection\n        as: $proj\n        options:\n          - { label: Equal Earth (true areas), value: equal-earth }\n          - { label: Mercator (web maps), value: mercator }\n          - { label: Equirectangular, value: equirectangular }\n          - { label: Orthographic (a globe), value: orthographic }\n          - { label: Azimuthal equal-area, value: azimuthal-equal-area }\n          - { label: Stereographic, value: stereographic }\n          - { label: Transverse Mercator, value: transverse-mercator }\n      - input: slider\n        label: Centre on longitude\n        as: $centre\n        min: -180\n        max: 180\n        step: 1\n  - plot:\n      - mark: sphere\n        fill: '#0b1d33'\n        stroke: currentColor\n        strokeOpacity: 0.3\n      - mark: graticule\n        strokeOpacity: 0.12\n      - mark: geo\n        data: { from: countries }\n        geometry: { geojson: geom }\n        fill: '#2a2f38'\n        stroke: '#11141a'\n        strokeWidth: 0.4\n      - mark: geo\n        data: { from: countries, filterBy: $pick }\n        geometry: { geojson: geom }\n        fill: inflation\n        stroke: '#11141a'\n        strokeWidth: 0.4\n      - mark: geo\n        data: { from: tissot }\n        geometry: { geojson: geom }\n        fill: white\n        fillOpacity: 0.22\n        stroke: white\n        strokeOpacity: 0.7\n        strokeWidth: 0.8\n    name: world\n    projectionType: $proj\n    projectionRotate: $rotate\n    colorScale: log\n    colorDomain: [1, 20]\n    colorRange: ['#3B6E8F', '#6A9BB5', '#E8D9A8', '#F4A259', '#E4572E', '#B5121B']\n    colorInterpolate: rgb\n    colorClamp: true\n    margin: 6\n  - legend: color\n    for: world\n    label: Times larger on a Mercator map\n",
                "variables": ""
              }
            },
            "version": "2.3.2"
          }
        }
      }
