    "title": "Projections: how much Mercator inflates every country",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "description": "Natural Earth's countries with their real area and their area on a Mercator map.",
          "hide": "hideVariable",
          "includeAll": false,
          "label": "Countries",
          "multi": false,
          "name": "countries",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "countries",
              "refId": "countries",
              "source": {
                "sql": "-- In the browser: Natural Earth's countries (1:50 million), each with its real area on the ellipsoid and the area\n-- it takes on a Mercator map (Web Mercator, EPSG:3857, cut at 85° like every web map), and how many times larger\n-- Mercator draws it. lat is the latitude of its centroid; rank orders the countries of 50,000 km² or more by that\n-- inflation, Antarctica left out (Mercator cannot draw the pole: cut at 85° it is still 23 times too large).\nWITH c AS (\n  SELECT f.properties.NAME::VARCHAR AS name, f.properties.CONTINENT::VARCHAR AS continent,\n         ST_GeomFromGeoJSON(to_json(f.geometry)) AS geom\n  FROM read_json('https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_50m_admin_0_countries.geojson'), unnest(features) AS t(f)\n), a AS (\n  SELECT name, continent, geom,\n         ST_Area_Spheroid(ST_FlipCoordinates(geom)) / 1e6 AS km2,\n         ST_Area(ST_Transform(ST_Intersection(geom, ST_MakeEnvelope(-180, -85, 180, 85)), 'EPSG:4326', 'EPSG:3857',\n                              always_xy := true)) / 1e6 AS merc_km2,\n         round(ST_Y(ST_Centroid(geom)), 1) AS lat\n  FROM c\n)\nSELECT name, continent, round(km2)::INTEGER AS km2, round(merc_km2)::BIGINT AS merc_km2,\n       round(merc_km2 / km2, 2) AS inflation, lat,\n       CASE WHEN name = 'Antarctica' OR km2 \u003c 50000 THEN NULL\n            ELSE row_number() OVER (PARTITION BY name = 'Antarctica' OR km2 \u003c 50000 ORDER BY merc_km2 / km2 DESC) END AS rank,\n       geom\nFROM a WHERE km2 \u003e 0",
                "type": "sql"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": true,
          "sort": "disabled"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "description": "Tissot's circles: 1,000 km across, on a 30° by 25° grid.",
          "hide": "hideVariable",
          "includeAll": false,
          "label": "Tissot",
          "multi": false,
          "name": "tissot",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "tissot",
              "refId": "tissot",
              "source": {
                "sql": "-- In the browser: Tissot's circles, every one 1,000 km across on the ground, every 30° of longitude and 25° of\n-- latitude. Drawn in a projection, each shows how that projection stretches the land there.\nWITH centre AS (\n  SELECT lon::DOUBLE AS lon, lat::DOUBLE AS lat FROM range(-165, 180, 30) AS a(lon), range(-75, 76, 25) AS b(lat)\n), ring AS (\n  SELECT lon, lat, k, radians(k * 10) AS b, 500 / 6371.0 AS d FROM centre, range(0, 37) AS r(k)\n), pt AS (\n  SELECT lon, lat, k,\n         asin(sin(radians(lat)) * cos(d) + cos(radians(lat)) * sin(d) * cos(b)) AS lat2, b, d\n  FROM ring\n)\nSELECT lon, lat,\n       ST_GeomFromText('POLYGON((' || string_agg(\n         round(lon + degrees(atan2(sin(b) * sin(d) * cos(radians(lat)), cos(d) - sin(radians(lat)) * sin(lat2))), 4)\n         || ' ' || round(degrees(lat2), 4), ', ' ORDER BY k) || '))') AS geom\nFROM pt GROUP BY lon, lat",
                "type": "sql"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": true,
          "sort": "disabled"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "description": "Mercator's enlargement by latitude.",
          "hide": "hideVariable",
          "includeAll": false,
          "label": "Curve",
          "multi": false,
          "name": "curve",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "curve",
              "refId": "curve",
              "source": {
                "sql": "-- In the browser: how much Mercator enlarges areas at each latitude, 1 / cos²(latitude).\nSELECT lat::DOUBLE AS lat, 1 / pow(cos(radians(lat)), 2) AS inflation FROM range(-84, 85) AS t(lat)",
                "type": "sql"
              }
            },
            "version": "v0"
          },
