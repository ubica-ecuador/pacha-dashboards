                "spec": "params:\n  ufoFilters: { select: crossfilter }\nplot:\n  - mark: rectY\n    data: { from: ufo, filterBy: $ufoFilters }\n    x: { bin: year, step: 1 }\n    y: { count: }\n    fill: '#73BF69'\n    inset: 0.5\n  - select: intervalX\n    as: $ufoFilters\nxTickFormat: d\nyGrid: true\nxLabel: year →\nyLabel: null\nmarginLeft: 44\nmarginBottom: 32\n",
                "variables": "- param: ufoFilters\n  column: year\n  from: yr_lo\n  to: yr_hi\n"
              }
            },
            "version": "2.3.2"
          }
        }
