          "name": "ufo",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "ufo",
              "refId": "ufo",
              "source": {
                "datasource": {
                  "type": "motherduck-duckdb-datasource",
                  "uid": "duckdb"
                },
                "query": {
                  "datasource": {
                    "type": "motherduck-duckdb-datasource",
                    "uid": "duckdb"
                  },
                  "editorMode": "code",
                  "format": 1,
                  "rawQuery": true,
                  "rawSql": "-- NUFORC reports, geocoded: datasets/ufo-sightings/build.sh keeps planetsig's CSV column for column, as text.\n-- Cast safely here, because a few rows are malformed.\n-- Day of year is counted on a leap-year calendar, so a date is always the same day (July 4th is 186).\n-- Datetime is M/D/YYYY HH:MM; a few say 24:00, which falls back to midnight of that date.\nWITH raw AS (\n  SELECT * FROM 'http://feeds/datasets/ufo-sightings/nuforc.parquet'\n),\nt AS (\n  SELECT *, coalesce(try_strptime(datetime, '%m/%d/%Y %H:%M'), try_strptime(split_part(datetime, ' ', 1), '%m/%d/%Y')) AS time,\n         try_cast(latitude AS DOUBLE) AS lat, try_cast(longitude AS DOUBLE) AS lng\n  FROM raw\n)\nSELECT row_number() OVER () AS id, time, lat AS latitude, lng AS longitude,\n       year(time)::INTEGER AS year, (floor(year(time) / 10) * 10)::INTEGER AS decade,\n       hour(time)::INTEGER AS hour, dayofyear(make_date(2000, month(time), day(time)))::INTEGER AS doy,\n       strftime(time, '%a') AS dow, dayofweek(time)::INTEGER AS dow_num,\n       coalesce(nullif(shape, ''), 'unknown') AS shape, city, upper(state) AS state, upper(country) AS country,\n       try_cast(duration_s AS DOUBLE) AS duration_s\nFROM t\nWHERE time IS NOT NULL AND lat BETWEEN -90 AND 90 AND lng BETWEEN -180 AND 180 AND year(time) \u003e= 1900",
                  "refId": "ufo"
                },
                "type": "datasource"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": true,
          "sort": "disabled"
        }
