          "description": "Water and trees are the coolest by day, fields the hottest: Landsat's 30 m pixels at 12:55 by their ESA WorldCover class, against the countryside: the bar is the middle half, coloured by its median on the maps' scale; the line runs from the 10th to the 90th percentile; the tick is the median.",
          "id": 8,
          "links": [],
          "title": "By land cover, at 12:55",
          "vizConfig": {
            "group": "ubica-chaski-mosaic-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "preaggregate": true,
                "reads": "",
                "spec": "# Landsat's 30 m pixels by land cover, by day: the middle half as a bar\n# coloured by its median on the maps' scale, the 10th to 90th percentiles as a\n# line, the median as a tick.\nplot:\n  - mark: ruleX\n    data: [0]\n    stroke: currentColor\n    strokeOpacity: 0.35\n  - mark: ruleY\n    data: { from: landcover }\n    y: class\n    x1: p10\n    x2: p90\n    stroke: currentColor\n    strokeOpacity: 0.5\n  - mark: barX\n    data: { from: landcover }\n    y: class\n    x1: p25\n    x2: p75\n    fill: p50\n    inset: 4\n  - mark: tickX\n    data: { from: landcover }\n    y: class\n    x: p50\n    stroke: currentColor\n    strokeWidth: 2\n    inset: 4\nyDomain: ['Water', 'Trees', 'Built-up', 'Bare ground', 'Scrub and grass', 'Cropland']\ncolorScale: linear\ncolorDomain: [-6, -3, -1, 0, 1, 3, 6]\ncolorRange: ['#2166ac', '#67a9cf', '#d1e5f0', '#f7f7f7', '#fddbc7', '#ef8a62', '#b2182b']\ncolorClamp: true\nxDomain: [-22, 6]\nxLabel: '°C against the countryside at 12:55 →'\nyLabel: null\nmarginLeft: 110\n",
                "variables": ""
              }
            },
            "version": "2.2.0"
          }
