    "title": "Madrid's heat island comes out at night",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "label": "The square kilometres of the frame",
          "multi": false,
          "name": "cells",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "cells",
              "refId": "cells",
              "source": {
                "datasource": {
                  "type": "motherduck-duckdb-datasource",
                  "uid": "duckdb"
                },
                "query": {
                  "datasource": {
                    "type": "motherduck-duckdb-datasource",
                    "uid": "duckdb"
                  },
                  "editorMode": "code",
                  "format": 1,
                  "rawQuery": true,
                  "rawSql": "-- Server side, once per visit: the 3,600 square kilometres of a 60 km frame\n-- around Puerta del Sol (datasets/madrid-heat): each with its share of every\n-- land cover (ESA WorldCover 2021), its July 2026 surface temperature in °C\n-- (Landsat by day at 12:55, averaged to the square; MODIS by day at 11:33 and\n-- at night at 22:39), each against the countryside (the median of the squares\n-- under 5 % built-up), its distance to Puerta del Sol, and its outline.\nSELECT px, py, longitude, latitude, dist_km, rural, built, trees, cropland, scrub_grass, bare, water,\n       landsat, day, night, landsat_vs, day_vs, night_vs, geometry::VARCHAR AS geometry\nFROM read_parquet('http://feeds/datasets/madrid-heat/cells.parquet')",
                  "refId": "cells"
                },
                "type": "datasource"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": false,
          "sort": "disabled"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "label": "By day, by land cover",
          "multi": false,
          "name": "landcover",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "landcover",
              "refId": "landcover",
              "source": {
                "datasource": {
                  "type": "motherduck-duckdb-datasource",
                  "uid": "duckdb"
                },
                "query": {
                  "datasource": {
                    "type": "motherduck-duckdb-datasource",
                    "uid": "duckdb"
                  },
                  "editorMode": "code",
                  "format": 1,
                  "rawQuery": true,
                  "rawSql": "-- Server side, once per visit: Landsat's 30 m pixels by land cover (ESA\n-- WorldCover 2021), by day at 12:55 in July 2026, in °C against the\n-- countryside: how many, and their 10th to 90th percentiles.\nSELECT class, pixels, p10, p25, p50, p75, p90 FROM read_parquet('http://feeds/datasets/madrid-heat/landcover.parquet')",
                  "refId": "landcover"
                },
                "type": "datasource"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": false,
          "sort": "disabled"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "label": "Each square kilometre, by day and by night",
          "multi": false,
          "name": "long",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "long",
              "refId": "long",
              "source": {
                "sql": "-- In your browser, once: the squares within 30 km of Puerta del Sol, one row\n-- per square and pass, with the kilometre and the tenth of built-up it falls\n-- in (the middle of the bin) and its °C against the countryside.\nSELECT k.series, floor(c.dist_km) + 0.5 AS km, least(floor(c.built * 10), 9) * 10 + 5 AS built,\n       CASE k.n WHEN 1 THEN c.landsat_vs WHEN 2 THEN c.day_vs ELSE c.night_vs END AS vs\nFROM $cells AS c,\n     (VALUES (1, 'By day, 12:55 (Landsat, 30 m)'), (2, 'By day, 11:33 (MODIS, 1 km)'), (3, 'By night, 22:39 (MODIS, 1 km)')) AS k(n, series)\nWHERE c.dist_km < 30",
                "type": "sql"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": false,
          "sort": "disabled"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "label": "The city against its countryside",
          "multi": false,
          "name": "city",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "city",
              "refId": "city",
              "source": {
                "sql": "-- In your browser, once: the city (the squares at least half built-up)\n-- against the countryside, the median °C by day and by night.\nSELECT median(landsat_vs) FILTER (WHERE built >= 0.5) AS day,\n       median(day_vs) FILTER (WHERE built >= 0.5) AS day_modis,\n       median(night_vs) FILTER (WHERE built >= 0.5) AS night,\n       count(*) FILTER (WHERE built >= 0.5) AS squares\nFROM $cells",
                "type": "sql"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": false,
          "sort": "disabled"
        }
