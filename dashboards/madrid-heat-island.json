      "panel-profile": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The median of the square kilometres at each distance from Puerta del Sol, against the countryside: below zero by day, above it at night, both fading by 20 km. Brush the built-up chart to keep only squares that built-up.",
          "id": 6,
          "links": [],
          "title": "Out from Puerta del Sol",
          "vizConfig": {
            "group": "ubica-chaski-mosaic-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "preaggregate": true,
                "reads": "",
                "spec": "# The median of the square kilometres at each distance from Puerta del Sol,\n# by pass, against the countryside. The brush on the built-up chart keeps only\n# the squares that built-up.\nparams:\n  cellFilters: { select: crossfilter }\nvconcat:\n  - legend: color\n    for: profile\n  - name: profile\n    plot:\n      - mark: ruleY\n        data: [0]\n        stroke: currentColor\n        strokeOpacity: 0.35\n      - mark: lineY\n        data: { from: long, filterBy: $cellFilters }\n        x: km\n        y: { median: vs }\n        stroke: series\n        strokeWidth: 2.5\n        curve: monotone-x\n      - mark: dot\n        data: { from: long, filterBy: $cellFilters }\n        x: km\n        y: { median: vs }\n        fill: series\n        r: 2.5\n    colorDomain: ['By day, 12:55 (Landsat, 30 m)', 'By day, 11:33 (MODIS, 1 km)', 'By night, 22:39 (MODIS, 1 km)']\n    colorRange: ['#F2A93B', '#F7D79A', '#7B8CF5']\n    xDomain: [0, 30]\n    yDomain: [-7, 6]\n    xLabel: 'Kilometres from Puerta del Sol →'\n    yLabel: '↑ °C against the countryside'\n    marginLeft: 36\n",
                "variables": ""
              }
            },
            "version": "2.2.0"
          }
        }
      }
