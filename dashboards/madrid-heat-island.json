                      "group": "ubica-chaski-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "rawSql": "-- Every square kilometre, invisible until hovered: its figures.\nSELECT round(landsat, 1) AS \"Day, 12:55 (°C)\", round(landsat_vs, 1) AS \"Day, against the countryside\",\n       round(night, 1) AS \"Night, 22:39 (°C)\", round(night_vs, 1) AS \"Night, against the countryside\",\n       round(100 * built)::INTEGER AS \"Built-up (%)\", round(dist_km, 1) AS \"From Puerta del Sol (km)\", geometry\nFROM $cells"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
