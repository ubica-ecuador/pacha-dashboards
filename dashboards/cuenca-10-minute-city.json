          "multi": false,
          "name": "curve",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "curve",
              "refId": "curve",
              "source": {
                "sql": "-- In your browser, once: for every minute of the walk, the share of the people\n-- of Cuenca by how many of the six needs they reach by then (exactly n, 0 to\n-- 6). Rows of the clock: the window shows the minutes up to its end.\nWITH people AS (SELECT sum(population) AS total FROM $cells),\ncounts AS (\n  SELECT t.m AS minute, c.population,\n         coalesce(c.food \u003c= t.m, false)::INTEGER\n         + coalesce(c.pharmacy \u003c= t.m, false)::INTEGER\n         + coalesce(c.health \u003c= t.m, false)::INTEGER\n         + coalesce(c.school \u003c= t.m, false)::INTEGER\n         + coalesce(c.park \u003c= t.m, false)::INTEGER\n         + coalesce(c.stop \u003c= t.m, false)::INTEGER AS n\n  FROM $cells AS c, range(1, 16) AS t(m)\n)\nSELECT minute::INTEGER AS minute, n, n::VARCHAR || ' of 6' AS within, sum(population) / any_value(people.total) AS share,\n       TIMESTAMP '2026-11-07 07:00:00' + (minute - 1) * INTERVAL 1 MINUTE + INTERVAL 30 SECOND AS time\nFROM counts, people\nGROUP BY minute, n\nORDER BY n DESC, minute",
                "type": "sql"
              }
            },
            "version": "v0"
          },
