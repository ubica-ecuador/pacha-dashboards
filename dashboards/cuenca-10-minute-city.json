          "hide": "hideVariable",
          "includeAll": false,
          "label": "Cells with the minutes to each need",
          "multi": false,
          "name": "cells",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "cells",
              "refId": "cells",
              "source": {
                "datasource": {
                  "type": "motherduck-duckdb-datasource",
                  "uid": "duckdb"
                },
                "query": {
                  "datasource": {
                    "type": "motherduck-duckdb-datasource",
                    "uid": "duckdb"
                  },
                  "editorMode": "code",
                  "format": 1,
                  "rawQuery": true,
                  "rawSql": "-- Server side, once per visit: every cell of R5's grid of Cuenca (Web Mercator,\n-- zoom 10, about 153 m) with people or a street (datasets/cuenca-access): the\n-- people LlactaLAB counts in it and, from datasets/cuenca-walk (where R5 runs),\n-- the minutes on foot to the nearest place of each of six daily needs, which R5\n-- walked on the city's streets at 1.3 m/s; null past 15 minutes. px and py are\n-- the cell's column and row, which the streets join on.\nWITH walk AS (\n  SELECT px, py,\n         min(minutes) FILTER (WHERE need = 'Food') AS food,\n         min(minutes) FILTER (WHERE need = 'Pharmacy') AS pharmacy,\n         min(minutes) FILTER (WHERE need = 'Health') AS health,\n         min(minutes) FILTER (WHERE need = 'School') AS school,\n         min(minutes) FILTER (WHERE need = 'Park') AS park,\n         min(minutes) FILTER (WHERE need = 'Transit') AS stop\n  FROM read_parquet('http://feeds/datasets/cuenca-walk/walk.parquet')\n  GROUP BY px, py\n),\npeople AS (\n  SELECT px, py, population FROM read_parquet('http://feeds/datasets/cuenca-access/population.parquet')\n),\ncells AS (\n  SELECT px, py FROM people\n  UNION SELECT DISTINCT px, py FROM read_parquet('http://feeds/datasets/cuenca-access/streets.parquet')\n)\nSELECT c.px::DOUBLE AS px, c.py::DOUBLE AS py, coalesce(p.population, 0)::DOUBLE AS population,\n       w.food::DOUBLE AS food, w.pharmacy::DOUBLE AS pharmacy, w.health::DOUBLE AS health, w.school::DOUBLE AS school, w.park::DOUBLE AS park, w.stop::DOUBLE AS stop\nFROM cells AS c\nLEFT JOIN people AS p USING (px, py)\nLEFT JOIN walk AS w USING (px, py)\nORDER BY py, px",
                  "refId": "cells"
                },
                "type": "datasource"
              }
            },
            "version": "v0"
          },
