      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "label": "Each need within reach, per cell, on the clock",
          "multi": false,
          "name": "reach",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "reach",
              "refId": "reach",
              "source": {
                "sql": "-- In your browser, once: one row per cell and need within a 15-minute walk.\n-- time is the walk's clock: the middle of the minute the need comes within\n-- reach (R5 counts a cell within m minutes when it reaches it in less than m,\n-- so minute m runs from m - 1 to m), leaving home at 7:00. k is\n-- the need's place among its cell's, the soonest first: when the clock's\n-- window ends at minute m, a cell keeps its rows of k = 1 to n, n the needs\n-- within m, and its streets take the colour of the last, drawn on top. share\n-- is the cell's part of the people of Cuenca, so a sum of share over the rows\n-- of one k or one need is a part of the city.\nWITH people AS (SELECT sum(population) AS total FROM $cells),\nlong AS (\n  SELECT c.px, c.py, c.population, k.ord, k.need,\n         CASE k.col WHEN 'food' THEN c.food WHEN 'pharmacy' THEN c.pharmacy WHEN 'health' THEN c.health WHEN 'school' THEN c.school WHEN 'park' THEN c.park WHEN 'stop' THEN c.stop END AS minutes\n  FROM $cells AS c,\n       (VALUES (1, 'food', 'Food shop or market'), (2, 'pharmacy', 'Pharmacy'), (3, 'health', 'Health centre'), (4, 'school', 'School'), (5, 'park', 'Park or square'), (6, 'stop', 'Bus or tram stop')) AS k(ord, col, need)\n),\nranked AS (\n  SELECT *, row_number() OVER (PARTITION BY px, py ORDER BY minutes, ord) AS k\n  FROM long\n  WHERE minutes IS NOT NULL\n)\nSELECT px, py, need, minutes, k, k::VARCHAR || ' of 6' AS within,\n       population / people.total AS share,\n       TIMESTAMP '2026-11-07 07:00:00' + (minutes - 1) * INTERVAL 1 MINUTE + INTERVAL 30 SECOND AS time\nFROM ranked, people\nORDER BY k",
                "type": "sql"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": false,
          "sort": "disabled"
        }
      },
