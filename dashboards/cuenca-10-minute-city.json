              "options": {
                "preaggregate": true,
                "reads": "",
                "spec": "params:\n  cityFilters: { select: crossfilter }\nplot:\n  - mark: text\n    data: { from: reach, filterBy: $cityFilters }\n    text: { sql: \"round(100 * (coalesce(sum(share) FILTER (WHERE k = 6), 0)))::INTEGER::VARCHAR || ' %'\" }\n    frameAnchor: middle\n    fill: '#FCF7B6'\n    fontSize: 26\n    fontWeight: 500\nxAxis: null\nyAxis: null\nmargin: 0\n",
                "variables": ""
              }
            },
            "version": "2.2.0"
          }
        }
