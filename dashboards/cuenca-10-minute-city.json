              "options": {
                "preaggregate": true,
                "reads": "",
                "spec": "# The people within the walk of each need (coloured), over those within 15\n# minutes (grey, the whole clock).\nparams:\n  cityFilters: { select: crossfilter }\nplot:\n  - mark: barX\n    data: { from: reach }\n    x: { sum: share }\n    y: need\n    fill: '#3A3A44'\n  - mark: barX\n    data: { from: reach, filterBy: $cityFilters }\n    x: { sum: share }\n    y: need\n    fill: '#F48713'\nxDomain: [0, 1]\nyDomain: ['Food shop or market', 'Pharmacy', 'Health centre', 'School', 'Park or square', 'Bus or tram stop']\nxLabel: People of Cuenca →\nxTickFormat: '%'\nyLabel: null\nmarginLeft: 120\n",
