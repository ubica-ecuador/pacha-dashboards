                  "rawQuery": true,
                  "rawSql": "-- Server side, once per visit: the places of the six daily needs\n-- (datasets/cuenca-walk/needs.parquet), one row per place; a park once per\n-- entrance.\nSELECT CASE need\n         WHEN 'Food' THEN 'Food shop or market'\n         WHEN 'Pharmacy' THEN 'Pharmacy'\n         WHEN 'Health' THEN 'Health centre'\n         WHEN 'School' THEN 'School'\n         WHEN 'Park' THEN 'Park or square'\n         WHEN 'Transit' THEN 'Bus or tram stop'\n       END AS need, name, latitude, longitude\nFROM read_parquet('http://feeds/datasets/cuenca-walk/needs.parquet')",
