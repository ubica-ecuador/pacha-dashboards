                    "uid": "duckdb"
                  },
                  "editorMode": "code",
                  "format": 1,
                  "rawQuery": true,
                  "rawSql": "-- Server side, once per visit: every road of Cuenca in Overture Maps, cut at\n-- the edges of R5's cells (datasets/cuenca-access), simplified to 2 m and\n-- rounded to 1 m, which the map cannot tell apart at street scale. The\n-- pieces of a cell all take its colour, so they come as one MultiLineString\n-- per cell: 20,000 features instead of 72,000.\nWITH parts AS (\n  SELECT px, py, unnest(ST_Dump(ST_ReducePrecision(ST_Simplify(geometry, 0.00002), 0.00001))).geom AS g\n  FROM read_parquet('http://feeds/datasets/cuenca-access/streets.parquet')\n)\nSELECT px::DOUBLE AS px, py::DOUBLE AS py, ST_AsGeoJSON(ST_Collect(list(g)))::VARCHAR AS geometry\nFROM parts\nWHERE ST_GeometryType(g) = 'LINESTRING' AND NOT ST_IsEmpty(g)\nGROUP BY px, py",
                  "refId": "streets"
                },
                "type": "datasource"
              }
            },
            "version": "v0"
          },
