          "description": "",
          "id": 4,
          "links": [],
          "title": "All six",
          "vizConfig": {
            "group": "ubica-chaski-mosaic-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
