                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "red",
                        "value": 80
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "zebraStriping": false
              }
            },
            "version": "13.3.0"
          }
        }
