      "panel-heights": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Buildings of the centre by where their height comes from.\nSELECT height_from AS \"Height from\", count(*) AS \"Buildings\", round(100.0 * count(*) / sum(count(*)) OVER (), 1) AS \"%\"\nFROM (SELECT DISTINCT building_id, height_from, height_m FROM read_parquet('http://feeds/datasets/cuenca-3d/surfaces.parquet') WHERE latitude BETWEEN -2.9035 AND -2.8925 AND longitude BETWEEN -79.0135 AND -78.9960)\nGROUP BY 1 ORDER BY 2 DESC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "OpenStreetMap's height, its floors x 3 m, the median of the measured buildings within 80 m (at least three), or 6 m.",
          "id": 3,
          "links": [],
          "title": "Where each height comes from",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
