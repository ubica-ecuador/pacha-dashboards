      "panel-products": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Every product The Nature Conservancy made from the flight, with its size and date as its ArcGIS item gives them.\nWITH products(item, product, format, shown) AS (VALUES\n  ('27cffcafffc2460b88bb7f21afd75df6', 'Gaussian splats', '3D Tiles 1.1, KHR_gaussian_splatting', 'Right of the curtain'),\n  ('a957491d210642f7959b1b50c57ed7fa', 'Integrated mesh', 'I3S scene layer, textured triangles', 'Left of the curtain'),\n  ('d0a3a5feebbc4e179580b635b3383fc7', 'Point cloud', 'I3S point cloud scene layer', 'Not drawn here'),\n  ('45797445c6e04ac99ba93ef54a01259d', 'Orthomosaic', 'Tiled map service, 2D picture', 'Not drawn here'),\n  ('71cafc446d014838b4bedf55a37e2e7b', 'Terrain model (DTM)', 'Tiled image service, bare ground heights', 'Not drawn here')\n)\nSELECT p.product AS \"Product\", p.format AS \"Format\", p.shown AS \"On these maps\",\n       round(i.size / 1e9, 2) AS \"Size\", to_timestamp(i.created / 1000) AS \"Published\", p.item AS \"ArcGIS item\"\nFROM products p JOIN read_json(['https://www.arcgis.com/sharing/rest/content/items/27cffcafffc2460b88bb7f21afd75df6?f=json', 'https://www.arcgis.com/sharing/rest/content/items/a957491d210642f7959b1b50c57ed7fa?f=json', 'https://www.arcgis.com/sharing/rest/content/items/d0a3a5feebbc4e179580b635b3383fc7?f=json', 'https://www.arcgis.com/sharing/rest/content/items/45797445c6e04ac99ba93ef54a01259d?f=json', 'https://www.arcgis.com/sharing/rest/content/items/71cafc446d014838b4bedf55a37e2e7b?f=json']) i ON i.id = p.item\nORDER BY i.size DESC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "What The Nature Conservancy made from the flight, as ArcGIS lists it; click an item for its page.",
          "id": 7,
          "links": [],
          "title": "One flight, five products",
          "vizConfig": {
