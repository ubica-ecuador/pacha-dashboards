      "card-mesh": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- The two products these maps draw, as ArcGIS lists them: their sizes, and how many the flight made.\nWITH products(item, product, format, shown) AS (VALUES\n  ('27cffcafffc2460b88bb7f21afd75df6', 'Gaussian splats', '3D Tiles 1.1, KHR_gaussian_splatting', 'Right of the curtain'),\n  ('a957491d210642f7959b1b50c57ed7fa', 'Integrated mesh', 'I3S scene layer, textured triangles', 'Left of the curtain'),\n  ('d0a3a5feebbc4e179580b635b3383fc7', 'Point cloud', 'I3S point cloud scene layer', 'Not drawn here'),\n  ('45797445c6e04ac99ba93ef54a01259d', 'Orthomosaic', 'Tiled map service, 2D picture', 'Not drawn here'),\n  ('71cafc446d014838b4bedf55a37e2e7b', 'Terrain model (DTM)', 'Tiled image service, bare ground heights', 'Not drawn here')\n)\nSELECT count(*) AS \"Products\",\n       round(sum(i.size) FILTER (WHERE p.product = 'Gaussian splats') / 1e9, 2) AS \"Splats\",\n       round(sum(i.size) FILTER (WHERE p.product = 'Integrated mesh') / 1e9, 2) AS \"Mesh\"\nFROM products p JOIN read_json(['https://www.arcgis.com/sharing/rest/content/items/27cffcafffc2460b88bb7f21afd75df6?f=json', 'https://www.arcgis.com/sharing/rest/content/items/a957491d210642f7959b1b50c57ed7fa?f=json', 'https://www.arcgis.com/sharing/rest/content/items/d0a3a5feebbc4e179580b635b3383fc7?f=json', 'https://www.arcgis.com/sharing/rest/content/items/45797445c6e04ac99ba93ef54a01259d?f=json', 'https://www.arcgis.com/sharing/rest/content/items/71cafc446d014838b4bedf55a37e2e7b?f=json']) i ON i.id = p.item"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The mesh at its finest, as ArcGIS stores it. Your browser reads only the tiles in view.",
          "id": 3,
          "links": [],
          "title": "Integrated mesh",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
