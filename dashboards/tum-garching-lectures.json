{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "tum-garching-lectures"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "legacyOptions": {
            "type": "dashboard"
          },
          "name": "Annotations \u0026 Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "The Technical University of Munich's Garching campus on a Tuesday: two buildings floor by floor from OpenStreetMap's indoor mapping, each room in its kind and lit while a lecture is on, from TUM's room calendars; a card per building zoomed out.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Every room of the two buildings drawn inside (datasets/tum-garching): its floor, its kind from NavigaTUM's use,\n-- how many lectures it holds today, its outline.\nSELECT room, building, code, kind, use, level, floor_name, lectures, area_m2, geometry\nFROM 'http://feeds/datasets/tum-garching/rooms.parquet'\n"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Their corridors and halls.\nSELECT room, building, level, floor_name, geometry\nFROM 'http://feeds/datasets/tum-garching/corridors.parquet'\n"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Each floor of the two buildings, its rooms and corridors merged: what a floor seen through shows.\nSELECT building, level, floor_name, geometry\nFROM 'http://feeds/datasets/tum-garching/slabs.parquet'\n"
                      },
                      "version": "v0"
                    },
                    "refId": "C"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Walls along the rooms at half height, open at the doors OpenStreetMap maps.\nSELECT building, level, floor_name, height_m, geometry\nFROM 'http://feeds/datasets/tum-garching/walls.parquet'\n"
                      },
                      "version": "v0"
                    },
                    "refId": "D"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- The rooms in a lecture in the quarter hour the dashboard shows (the Time Brush moves it), lit up on their floor.\nSELECT slot, room, code, building, title, type, \"when\", level, floor_name, 1 AS in_lecture, geometry\nFROM 'http://feeds/datasets/tum-garching/lectures.parquet'\nWHERE slot \u003e= ${__from} AND slot \u003c ${__to}\n"
                      },
                      "version": "v0"
                    },
                    "refId": "F"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Every building of the campus as a facade: zoomed out all of them, indoors the ones not looked at.\nSELECT building, name, height_m, geometry\nFROM 'http://feeds/datasets/tum-garching/facades.parquet'\n"
                      },
                      "version": "v0"
                    },
                    "refId": "G"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- A callout over each room in a lecture: the lecture and the minutes left. The quarter is no time column here, so\n-- the callout draws no chart.\nSELECT room, title_short AS title, building, level, min_left, latitude, longitude\nFROM 'http://feeds/datasets/tum-garching/lectures.parquet'\nWHERE slot \u003e= ${__from} AND slot \u003c ${__to}\n"
                      },
                      "version": "v0"
                    },
                    "refId": "H"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
