                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- How many rooms are in a lecture each quarter hour of the day, 07:00 to 21:00.\nSELECT epoch_ms(time) AS time, rooms_in_lecture\nFROM 'http://feeds/datasets/tum-garching/quarters.parquet'\nORDER BY time\n"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "id": 2,
          "links": [],
          "title": "Rooms in a lecture, quarter by quarter",
          "vizConfig": {
