                "cursorPublish": true,
                "domain": "data",
                "hatchGaps": false,
                "loop": true,
                "output": "range",
                "outsideOpacity": 35,
                "publishIntervalMs": 800,
                "publishWhilePlaying": true,
                "scale": "linear",
                "selection": "range",
                "showHistogram": true,
                "showReadout": true,
                "snap": true,
                "snapTo": "buckets",
                "stepMs": 900,
                "windowMode": "interval"
              }
            },
            "version": ""
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- The lectures on in the quarter hour the dashboard shows; a room's name goes to its floor and rings it.\nSELECT slot, \"when\", title, type, room, floor, building_name AS building, code\nFROM 'http://feeds/datasets/tum-garching/lectures.parquet'\nWHERE slot \u003e= ${__from} AND slot \u003c ${__to}\n"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "slot": true,
                        "type": true,
                        "when": true
                      },
                      "indexByName": {
                        "building": 3,
                        "floor": 2,
                        "room": 0,
                        "title": 1
                      },
                      "renameByName": {
                        "building": "Building",
                        "floor": "Floor",
                        "room": "Room",
                        "title": "Lecture"
                      }
                    }
                  }
                },
                {
                  "group": "sortBy",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "sort": [
                        {
                          "field": "Building"
                        },
                        {
                          "field": "Floor"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          "description": "The lectures of the quarter hour shown; a room flies the map to it.",
